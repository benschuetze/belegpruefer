{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env*.local)",
      "Read(.env.production*)",
      "Read(.env.preview*)",
      "Read(.env.development*)",
      "Read(.env.test*)",
      "Read(.env.staging*)",
      "Edit(.env)",
      "Edit(.env*.local)",
      "Edit(.env.production*)",
      "Edit(.env.preview*)",
      "Edit(.env.development*)",
      "Edit(.env.test*)",
      "Edit(.env.staging*)",
      "Edit(/drizzle/meta/**)",
      "Edit(/evals/belege.json)"
    ],
    "ask": [
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit-size.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
