# Neon (Region Frankfurt), pooled connection string. Lokal: pnpm db:local → postgres://postgres@127.0.0.1:5433/postgres
# Die App verbindet sich mit einer Rolle ohne ALTER und TRUNCATE (anlegen: pnpm db:app-login).
DATABASE_URL=
# Eigentümer der Tabellen, nur für Migrationen, Seed und Demo-Reset. Leer: DATABASE_URL (lokal üblich).
MIGRATION_DATABASE_URL=

# Agenten. Ohne Key und ohne AI_MOCK landet jeder Beleg in „prüfen“.
ANTHROPIC_API_KEY=
# nur nötig, wenn der Key für mehrere Workspaces gilt
ANTHROPIC_WORKSPACE_ID=
# Modelle je Rolle überschreiben (Standard: Kontierer/Recherche claude-haiku-5-5, Prüfer/Extraktor claude-sonnet-5-5)
AI_MODEL_KONTIERER=
AI_MODEL_PRUEFER=
AI_MODEL_RECHERCHE=
AI_MODEL_EXTRAKTOR=
# 1 = feste Stichwort-Modelle statt echtem LLM (Tests, Demo)
AI_MOCK=
# KI-Aufrufe pro Tag, Standard 600
LLM_DAILY_LIMIT=

# Login (ein Passwort pro Instanz)
APP_PASSWORD=
# mindestens 32 Zeichen: openssl rand -hex 32
SESSION_SECRET=

# true auf der öffentlichen Demo: nur lesen, erfundene Belege werden beim Build geladen
DEMO_MODE=false
