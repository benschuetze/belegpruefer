# Neon (Region Frankfurt), pooled connection string. Lokal: pnpm db:local → postgres://postgres@127.0.0.1:5433/postgres
# Eigentümer der Tabellen: Migrationen, Seed, Demo-Reset.
DATABASE_URL=
# Passwort der Login-Rolle belegpruefer_web (ohne ALTER und TRUNCATE), mindestens 32 Zeichen: openssl rand -hex 32
# Der Build legt die Rolle damit an (pnpm db:app-login), die App verbindet als sie. Leer: App nutzt DATABASE_URL
# (lokal üblich). In Produktion Pflicht, der Build prüft es.
APP_DB_PASSWORD=
# 1 gegen die lokale PGlite (pnpm db:local): ein Backend für alle Verbindungen. Sonst leer.
DATABASE_POOL_MAX=

# Agenten. Ohne Key und ohne AI_MOCK landet jeder Beleg in „prüfen“.
ANTHROPIC_API_KEY=
# nur nötig, wenn der Key für mehrere Workspaces gilt
ANTHROPIC_WORKSPACE_ID=
# Modelle je Rolle überschreiben (Standard: Kontierer/Recherche claude-haiku-5-5, Prüfer/Extraktor claude-sonnet-5-5)
AI_MODEL_KONTIERER=
AI_MODEL_PRUEFER=
AI_MODEL_RECHERCHE=
AI_MODEL_EXTRAKTOR=
# 1 = feste Stichwort-Modelle statt echtem LLM (Tests, Demo)
AI_MOCK=
# KI-Aufrufe pro Tag, Standard 600
LLM_DAILY_LIMIT=

# Login (ein Passwort pro Instanz)
APP_PASSWORD=
# mindestens 32 Zeichen: openssl rand -hex 32
SESSION_SECRET=

# true auf der öffentlichen Demo: nur lesen, erfundene Belege werden beim Build geladen
DEMO_MODE=false
